#!/bin/sh
# Configure uhttpd for the HAMNET web UI:
#   - HTTP Basic Auth on the CGI and app paths (reuses the root password)
#
# We intentionally keep uhttpd's default listen (0.0.0.0:80). Binding to the
# LAN IP only is fragile at boot: uhttpd (S50) may start before br-lan has its
# address, so bind() fails and the service never comes up (it only works on a
# manual start later). The wan-zone firewall (input DROP on wwan) already keeps
# the HAMNET side out, and HTTP Basic Auth (root password) is the real guard.

HTTPD_CONF=/etc/httpd.conf

add_auth() { grep -qF "$1" "$HTTPD_CONF" 2>/dev/null || echo "$1" >> "$HTTPD_CONF"; }

touch "$HTTPD_CONF"
# Format: prefix:username:password  ($p$root => check against the system 'root' password)
add_auth '/cgi-bin/hamnet:root:$p$root'
add_auth '/hamnet:root:$p$root'

if uci -q get uhttpd.main >/dev/null; then
	uci set uhttpd.main.config='/etc/httpd.conf'
	uci commit uhttpd
	/etc/init.d/uhttpd enable
	/etc/init.d/uhttpd restart
fi

exit 0