#!/bin/sh
# Configure uhttpd for the HAMNET web UI:
#   - HTTP Basic Auth on the CGI and app paths (reuses the root password)
#   - bind the web server to the LAN address only (see topology note)

HTTPD_CONF=/etc/httpd.conf

add_auth() { grep -qF "$1" "$HTTPD_CONF" 2>/dev/null || echo "$1" >> "$HTTPD_CONF"; }

touch "$HTTPD_CONF"
# Format: prefix:username:password  ($p$root => check against the system 'root' password)
add_auth '/cgi-bin/hamnet:root:$p$root'
add_auth '/hamnet:root:$p$root'

if uci -q get uhttpd.main >/dev/null; then
	uci set uhttpd.main.config='/etc/httpd.conf'

	lan_ip="$(uci -q get network.lan.ipaddr)"
	if [ -n "$lan_ip" ]; then
		uci -q delete uhttpd.main.listen_http
		uci -q delete uhttpd.main.listen_https
		uci add_list uhttpd.main.listen_http="$lan_ip:80"
	fi

	uci commit uhttpd
	/etc/init.d/uhttpd restart
fi

exit 0
