--- a/net/wireless/scan.c	2026-06-14 12:45:47.072195149 +0200
+++ b/net/wireless/scan.c	2026-06-14 12:46:28.506055276 +0200
@@ -1074,6 +1074,9 @@
 	int channel_number = -1;
 	struct ieee80211_channel *alt_channel;
 
+	printk(KERN_DEBUG "HAMNET-DBG: bss_channel scan_width=%d rx_freq=%d\n",
+    	scan_width, channel->center_freq);
+
 	tmp = cfg80211_find_ie(WLAN_EID_DS_PARAMS, ie, ielen);
 	if (tmp && tmp[1] == 1) {
 		channel_number = tmp[2];
@@ -1091,6 +1094,16 @@
 		return channel;
 	}
 
+	/* HAMNET / quarter- and half-rate channels: the channel
+	 * number to frequency mapping is not unambiguous (the same
+	 * channel number maps to different frequencies than the
+	 * standard 2.4 GHz plan), so we cannot trust the DS Parameter
+	 * Set channel number. Rely on the driver-reported RX channel instead. */
+	if (scan_width == NL80211_BSS_CHAN_WIDTH_5 || 
+		scan_width == NL80211_BSS_CHAN_WIDTH_10) {
+			return channel;
+		}
+
 	freq = ieee80211_channel_to_frequency(channel_number, channel->band);
 	alt_channel = ieee80211_get_channel(wiphy, freq);
 	if (!alt_channel) {
@@ -1101,6 +1114,10 @@
 			 * BSS on channel 12 when radio is configured for
 			 * channel 11.
 			 */
+			
+			printk(KERN_DEBUG "HAMNET-DBG: bss_channel REJECT ds_chan=%d ds_freq=%d rx_freq=%d\n",
+			channel_number, freq, channel->center_freq);
+
 			return NULL;
 		}
 
@@ -1234,6 +1251,9 @@
 
 	trace_cfg80211_inform_bss_frame(wiphy, data, mgmt, len);
 
+	printk(KERN_DEBUG "HAMNET-DBG: inform_bss_frame chan=%d len=%zu\n",
+       channel ? channel->center_freq : -1, len);
+
 	if (WARN_ON(!mgmt))
 		return NULL;
 
