--- a/src/common/ieee802_11_common.c
+++ b/src/common/ieee802_11_common.c
@@ -732,6 +732,20 @@ enum hostapd_hw_mode ieee80211_freq_to_c
 	if (sec_channel > 1 || sec_channel < -1)
 		return NUM_HOSTAPD_MODES;
 
+	/* HAMNET 13cm band: separate positive channel range (100..119), u8-safe */
+	if (freq >= 2312 && freq <= 2407) {
+		if ((freq - 2312) % 5)
+			return NUM_HOSTAPD_MODES;
+
+		if (vht)
+			return NUM_HOSTAPD_MODES;
+
+		*op_class = 81;
+		*channel = (freq - 2312) / 5 + 100;   /* 2312->100, 2362->110, 2377->113 */
+
+		return HOSTAPD_MODE_IEEE80211G;
+	}
+
 	if (freq >= 2412 && freq <= 2472) {
 		if ((freq - 2407) % 5)
 			return NUM_HOSTAPD_MODES;
@@ -1113,6 +1127,9 @@ static int ieee80211_chan_to_freq_global
 	/* Table E-4 in IEEE Std 802.11-2012 - Global operating classes */
 	switch (op_class) {
 	case 81:
+		/* HAMNET 13cm: channels 100..119 -> 2312..2407 */
+    	if (chan >= 100 && chan <= 119)
+        	return 2312 + (chan - 100) * 5;
 		/* channels 1..13 */
 		if (chan < 1 || chan > 13)
 			return -1;
